{
  "name": "dsh-remote-console",
  "version": "0.10.4",
  "description": "A right-sidebar SSH console for DeepSeek Harness where you and your agent share the same terminal and a unified activity log.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./client": "./lib/client.js"
  },
  "files": [
    "lib",
    "bin",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "test": "node tests/link-peers.mjs && node --test tests/*.test.mjs",
    "test:integration": "node --test tests/integration-sshd.test.mjs",
    "bench": "node scripts/bench.mjs",
    "market:index": "node scripts/market-index.mjs",
    "verify": "node scripts/check-release.mjs"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "ssh",
    "remote-console",
    "terminal"
  ],
  "license": "MIT",
  "engines": {
    "dsh": ">=0.2.1-rc.2 <0.3.0-0",
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-terminal-controller",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh-home-paths": ">=0.2.1-rc.2 <0.3.0",
    "@deepseek-ai/dsh-tools": ">=0.2.1-rc.2 <0.3.0",
    "@deepseek-ai/schemastery": ">=3.18.5 <4.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cccodder/dsh-remote-console.git"
  },
  "homepage": "https://github.com/cccodder/dsh-remote-console#readme",
  "bugs": {
    "url": "https://github.com/cccodder/dsh-remote-console/issues"
  }
}
